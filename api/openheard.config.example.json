{
  "dbPath": "./openheard.db",

  "dmrId": 4600000,

  "//clusterGapS": "间隔阈值，秒。这个值要来自对真实流量的实测，下面这个是占位，还没有依据。",
  "clusterGapS": 120,

  "pendingWindowDays": 7,
  "activityRetentionDays": 90,

  "//host": "默认只在本机。要从手机用就改成 0.0.0.0，那时管理端靠下面的口令挡着。",
  "host": "127.0.0.1",

  "//ingestToken": "openssl rand -hex 32",
  "ingestToken": "换成真的",

  "//adminPasswordHash": "node src/hash-password.ts '你的口令'",
  "adminPasswordHash": "换成真的",

  "//sessionSecret": "openssl rand -hex 32。换掉它，已登录的会话立刻失效。",
  "sessionSecret": "换成真的",

  "station": {
    "myCallsign": "BG0CG",
    "myGridsquare": "OM24",
    "myQth": "成都",
    "myDevice": "Quansheng UV-K6",
    "myAntenna": "Nagoya NA-771",
    "myPower": "5W",
    "myHeightM": 30,
    "networkFreqMhz": 439.525
  },

  "channels": [
    { "name": "439.525 中继", "freqMhz": 439.525, "mode": "FM" },
    { "name": "145.500 直频", "freqMhz": 145.5, "mode": "FM" }
  ],

  "//apiUrl": "守护进程往哪推。缺省就是这个，本机跑不用写。",
  "apiUrl": "http://127.0.0.1:3000",

  "//spoolDir": "推不上去时先落盘的目录，下一轮开始前补发。",
  "spoolDir": "./spool",

  "//analog": "模拟守听。整段去掉就只跑数字侧。一支接收机同时只能守一个频率。",
  "analog": {
    "freqMhz": 438.7,
    "channel": "438.700 直频",
    "gainDb": 32.8,
    "//myUnitId": "本台的 MDC-1200 unit ID，十六进制字符串。缺了就判不出哪次是本台，队列会一直空着。",
    "myUnitId": "6460",
    "recordingsDir": "./recordings"
  },

  "//queries": "每条规则单独一次查询。OR 合并时 amount 是全局上限，热闹的组会把安静的组饿死。",
  "queries": [
    {
      "key": "src:4600000",
      "rule": { "id": "SourceID", "operator": "equal", "value": 4600000 },
      "amount": 200,
      "intervalS": 3600
    },
    {
      "key": "dst:46001",
      "rule": { "id": "DestinationID", "operator": "equal", "value": 46001 },
      "amount": 200,
      "intervalS": 900
    }
  ]
}
